<Window x:Class="OnlineClipboard.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云剪贴板" Height="640" Width="920"
        MinHeight="520" MinWidth="720" Background="#F4F6FA"
        Loaded="OnLoaded" Closed="OnClosed">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="云剪贴板" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#5A6475" Text="正在启动…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="CaptureBox" Content="采集复制" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnToggleCapture" Unchecked="OnToggleCapture" />
                    <CheckBox x:Name="WriteBox" Content="自动写入" VerticalAlignment="Center" IsChecked="True" Checked="OnToggleWrite" Unchecked="OnToggleWrite" />
                </StackPanel>
            </Grid>
        </Border>
        <TabControl x:Name="Tabs">
            <TabItem Header="连接">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="服务器地址" FontWeight="SemiBold" />
                        <TextBox x:Name="OriginBox" Margin="0,6,0,8" Padding="8" Text="http://127.0.0.1:8080" />
                        <Button Content="测试连接" Width="120" HorizontalAlignment="Left" Click="OnTestOrigin" />
                        <TextBlock x:Name="OriginStatus" Margin="0,8,0,16" TextWrapping="Wrap" />
                        <TextBlock Text="账号" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="用户名" />
                                <TextBox x:Name="UserBox" Margin="0,4,0,8" Padding="6" />
                                <TextBlock Text="密码（12 位以上）" />
                                <PasswordBox x:Name="PassBox" Margin="0,4,0,8" Padding="6" />
                                <TextBlock Text="邀请码（注册）" />
                                <TextBox x:Name="InviteBox" Margin="0,4,0,8" Padding="6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="登录" Width="100" Click="OnLogin" />
                                    <Button Content="注册" Width="100" Margin="8,0,0,0" Click="OnRegister" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="恢复密钥" />
                                <TextBox x:Name="RecoveryBox" Margin="0,4,0,8" Padding="6" TextWrapping="Wrap" Height="64" />
                                <Button Content="解锁保险库" Width="140" HorizontalAlignment="Left" Click="OnUnlock" />
                                <Button Content="初始化新保险库" Width="140" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnInitVault" />
                                <TextBlock x:Name="KeyStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="历史">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="同步" Width="80" Click="OnSync" />
                        <TextBox x:Name="SearchBox" Margin="0,0,8,8" Padding="6" TextChanged="OnSearch" />
                    </DockPanel>
                    <ListBox x:Name="HistoryList" Grid.Row="1" SelectionChanged="OnSelectHistory" />
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="复制到本机" Width="110" Click="OnCopySelected" />
                            <Button Content="删除到回收站" Width="120" Margin="8,0,0,0" Click="OnTrashSelected" />
                        </StackPanel>
                        <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="回收站">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="TrashList" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="恢复" Width="100" Click="OnRestore" />
                        <Button Content="永久删除" Width="100" Margin="8,0,0,0" Click="OnPurge" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="设备">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="DeviceList" />
                    <Button Grid.Row="1" Content="撤销选中设备" Width="140" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRevoke" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
