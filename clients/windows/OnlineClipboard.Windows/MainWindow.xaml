<Window x:Class="OnlineClipboard.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云剪贴板 · 项目骨架" Height="440" Width="640"
        MinHeight="400" MinWidth="480" Background="#F4F6FA">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="云剪贴板" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,28" TextWrapping="Wrap" FontSize="15"
                       Text="跨设备文字同步 · 支持自托管" />
            <Border Background="White" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Windows 工程入口已就绪" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="14"
                               Text="当前为开发骨架。账号、服务器连接、加密、剪贴板监听、历史与回收站将在后续阶段实现。" />
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#5A6475"
                               Text="开发入口：docs/07-clients.md 和 docs/09-development-plan.md" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
